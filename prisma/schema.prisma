// TalkingHead AI - Database Schema
// Prisma schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH MODELS (NextAuth.js)
// ============================================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  password            String?   // Para credentials provider
  image               String?
  role                Role      @default(USER)
  forcePasswordChange Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  agentsCreated Agent[]        @relation("AgentCreator")
  agentAccess   UserAgentAccess[]  // Agentes que o usuário tem acesso

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// APPLICATION MODELS
// ============================================

enum Role {
  USER
  ADMIN
}

// ============================================
// AGENT / PERSONA MODELS
// ============================================

model Agent {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text  // Descrição pública do agente
  systemPrompt String   @db.Text  // System prompt para o LLM
  avatar       String?            // URL da foto/avatar
  voiceSample  String?            // URL do sample de áudio para clonagem
  
  // Configurações de voz
  voiceGender        String   @default("neutral")  // "male", "female", "neutral"
  voicePitch         Float    @default(1.0)        // 0.5-2.0 (grave-agudo)
  voiceSpeed         Float    @default(1.0)        // 0.5-2.0 (lento-rápido)
  
  // ElevenLabs TTS
  useElevenLabs      Boolean  @default(false)      // Usar ElevenLabs em vez de Coqui TTS
  elevenLabsVoiceId  String?                       // Voice ID do ElevenLabs
  
  // Controle de acesso
  isPublic     Boolean  @default(true)   // Se false, apenas usuários com acesso podem usar
  
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false) // Assistente padrão
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String

  // Relations
  createdBy     User            @relation("AgentCreator", fields: [createdById], references: [id])
  conversations Conversation[]
  knowledgeBase KnowledgeBase[]
  userAccess    UserAgentAccess[]  // Usuários com acesso a este agente

  @@map("agents")
}

model KnowledgeBase {
  id           String          @id @default(cuid())
  agentId      String
  fileName     String
  fileUrl      String          // Caminho do arquivo original
  fileSize     Int             // Tamanho em bytes
  fileType     String          // MIME type
  status       KnowledgeStatus @default(PENDING)
  chunkCount   Int?            // Número de chunks após vetorização
  errorMessage String?         // Mensagem de erro se falhar
  createdAt    DateTime        @default(now())
  processedAt  DateTime?

  // Relations
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("knowledge_base")
}

enum KnowledgeStatus {
  PENDING     // Aguardando processamento
  PROCESSING  // Em vetorização
  COMPLETED   // Pronto para uso
  FAILED      // Erro no processamento
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?  // Auto-gerado do primeiro message
  userId    String
  agentId   String?  // Null = assistente geral
  mode      ConversationMode @default(PUSH_TO_TALK)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([agentId])
  @@map("conversations")
}

enum ConversationMode {
  PUSH_TO_TALK
  LIVE_CALL
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String   @db.Text
  audioUrl       String?  // URL do áudio se houver
  
  // Métricas de latência
  sttLatencyMs   Int?
  llmLatencyMs   Int?
  ttsLatencyMs   Int?
  totalLatencyMs Int?
  
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String?  // Opcional: convite para um email específico
  role      Role     @default(USER)
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    String?  @unique // ID do usuário que usou
  createdAt DateTime @default(now())

  @@map("invitations")
}

// ============================================
// ACCESS CONTROL
// ============================================

model UserAgentAccess {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  grantedAt DateTime @default(now())
  grantedBy String?  // ID do admin que concedeu acesso

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
  @@index([agentId])
  @@map("user_agent_access")
}
